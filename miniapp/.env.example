# Mini App client env (Vite). Create this as miniapp/.env.local for local dev.
# In the all-in-one setup, the proxy is at the SAME origin as the Mini App,
# so you can leave VITE_API_BASE empty (uses relative URLs) — that's the recommended setup.

# If the Mini App is hosted separately from the server, set this to the server URL:
# VITE_API_BASE=https://your-server.up.railway.app
VITE_API_BASE=
