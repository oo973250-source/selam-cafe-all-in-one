> Copy this template to `.env` on the server (`cp env.example .env`) and fill in
> the real values. The real `.env` is git-ignored and must never be committed.

DATABASE_URL=
BOT_TOKEN=
JWT_SECRET=
ADMIN_TELEGRAM_IDS=
WEBAPP_URL=

# Recommended
WEBHOOK_SECRET=

# Optional
OWNER_TELEGRAM_ID=
NOTIFY_CHAT_IDS=
CHAPA_SECRET_KEY=
INTERNAL_SECRET=
