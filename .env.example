# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────
# From Railway Postgres plugin
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# ── Telegram Bot ────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBAPP_URL=https://your-app.up.railway.app

# Comma-separated Telegram chat IDs for staff notifications (optional)
NOTIFY_CHAT_IDS=
OWNER_TELEGRAM_ID=

# ── Chapa Payment ───────────────────────────────────────────────
# From https://dashboard.chapa.co
CHAPA_SECRET_KEY=cs_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=ck_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_SECRET=change-me-to-a-long-random-string
MOCK_MODE=true

# ── Admin Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRY=7d
TELEGRAM_BOT_NAME=SelamCafeBot
ADMIN_TELEGRAM_IDS=

# Internal secret for bot → admin real-time push (any random string)
INTERNAL_SECRET=change-me-to-another-random-string
